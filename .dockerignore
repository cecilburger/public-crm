# Mirrors .gitignore, plus git/CI/test-only material a build image never
# needs. Nothing here is optional: `.env` and the bridge auth directories are
# live credentials — a working WhatsApp/Instagram/Facebook session or this
# repo's own secrets — and the Dockerfile's final stage does `COPY . .`, so
# anything not excluded here is baked into an image layer forever, readable
# by anyone who ever pulls it.
.git/
node_modules/
**/node_modules/
dist/
.env
.env.local
*.log
.pgdata/
coverage/
.DS_Store
.next/
**/.next/
*.tsbuildinfo

apps/wa-bridge/.wwebjs_auth/
apps/wa-bridge/.wwebjs_cache/
apps/wa-bridge/data/
apps/ig-bridge/.ig_bridge_state/
apps/ig-bridge/.ig_bridge_auth/
apps/ig-bridge/.ig_bridge_auth_pptr/
apps/fb-bridge/.fb_bridge_auth/

/.dev-stack-data*/
/.dev-stack-pg/
