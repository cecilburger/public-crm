# Copy to .env and fill in. Nothing here has a safe default in production —
# the API refuses to boot if a development placeholder survives (see env.ts).

NODE_ENV=development
LOG_LEVEL=info
PORT=8080

# The API and worker connect as kirana_app, which is subject to row-level
# security and owns nothing. Migrations run as a separate owner role.
DATABASE_URL=postgres://kirana_app:kirana-app-local@localhost:5432/kirana
# The control pool (webhook spool, workspace lookup at login, inbound message
# routing) authenticates separately as kirana_provisioner — narrower cross-
# tenant access than kirana_app, never business data. See env.ts.
CONTROL_DATABASE_URL=postgres://kirana_provisioner:kirana-provisioner-local@localhost:5432/kirana
# The owner role, used by `npm run migrate` and by nothing else — neither the
# API nor the worker reads it. Without it the migrator falls back to
# DATABASE_URL, which owns nothing and will be refused by the schema. In
# production this belongs in the secret store, not in a file.
MIGRATION_DATABASE_URL=postgres://kirana_owner:kirana-owner-local@localhost:5432/kirana
DATABASE_MAX_CONNECTIONS=20
# 'transaction' when behind PgBouncer/RDS Proxy/Supavisor — it disables named
# prepared statements, which do not survive a pooler swapping the connection.
DATABASE_POOL_MODE=session
REDIS_URL=redis://localhost:6379

# Key-encrypting key: 32 bytes, base64. Wraps every tenant's data keys.
# Generate with: openssl rand -base64 32
# In production this lives in KMS/Secret Manager and is never written to disk.
KIRANA_KEK=BwcHBwcHBwcHBwcHBwcHBwcHBwcHBwcHBwcHBwcHBwc=

# Session signing. Rotate by running two secrets during the overlap window.
JWT_SECRET=dev-only-jwt-secret-change-me-000000
ACCESS_TOKEN_TTL_S=900
REFRESH_TOKEN_TTL_S=2592000

# Meta / WhatsApp Business Platform
META_APP_SECRET=dev-meta-app-secret
META_VERIFY_TOKEN=dev-verify-token
META_GRAPH_URL=https://graph.facebook.com/v21.0
# Comma-separated CIDRs Meta's webhooks may come from. Empty = unconfigured,
# which allows any source. The signature is required either way.
META_IP_ALLOWLIST=

# Bridges — apps/wa-bridge, apps/ig-bridge, apps/fb-bridge. Each runs as its
# own long-lived process, not stateless like the API/worker: it holds a live
# WhatsApp Web/Instagram/Facebook browser session in a profile directory on
# its own disk, so a fresh instance with no access to that directory means
# logging back in from scratch. None of the three are started by `docker
# compose up` in this file by default — see the `wa-bridge`/`ig-bridge`/
# `fb-bridge` services further down for how they're built, and give whichever
# of them you do run a persistent volume over that profile directory.
#
# KIRANA_API_URL is read by all three bridges themselves (not by the API or
# worker env below) — where they call back to report an event or reach the
# CRM. Unset defaults to http://127.0.0.1:8080, which only works when the
# bridge runs on the same host as the API; point it at the real API URL
# otherwise (the API's own base URL, not a bridge's).
KIRANA_API_URL=http://127.0.0.1:8080

# WhatsApp bridge (apps/wa-bridge) — whatsapp-web.js, one QR-paired session
# per connected number, scanned from the console like WhatsApp Web itself.
# No real browser window ever needed for this one — the QR is just an image.
WA_BRIDGE_URL=http://127.0.0.1:8090
WA_BRIDGE_SECRET=dev-wa-bridge-secret-change-me
# WhatsApp Web build for the bridge to load. Read by the bridge itself, not
# through env(). Empty means "whatever WhatsApp serves today", which is the
# normal setting and what this has always done. The catch is that
# whatsapp-web.js reaches into WhatsApp Web's internal modules, so a rename
# on their side breaks the bridge with no change on ours — we saw exactly
# that when a logged-out session started failing on
# `window.require('WAWebSocketModel')` returning null.
# Set this to a known-good build (e.g. 2.3000.1025091234) to get working
# again while whatsapp-web.js catches up. Builds are listed at
# https://github.com/wppconnect-team/wa-version — and unset it again
# afterwards, because WhatsApp eventually refuses builds it considers too old.
WA_WEB_VERSION=

# Instagram bridge (apps/ig-bridge) — instagram-private-api under a
# stealth-patched Puppeteer session: real DMs, and Page/post comments. Login
# is by password, a pasted sessionid cookie, or a real browser window the
# operator finishes by hand — that last one needs an actual display to look
# at, which a typical headless container does not have; see the
# `ig-bridge` service's own comment further down for what that means for a
# deployment.
IG_BRIDGE_URL=http://127.0.0.1:8091
IG_BRIDGE_SECRET=dev-ig-bridge-secret-change-me
# Headless by default — true unless set to exactly 'false'. Only the
# manual-login window (never anything else) forces a visible browser
# regardless of this setting; nothing else in the bridge honours it.
IG_BRIDGE_HEADLESS=true
# How often the comment sweep polls for new ones, in ms. Below 60000 is held
# at 60000. Unset means 5 minutes.
IG_COMMENT_POLL_MS=300000
# Sends the DM opener even to someone the bridge can already see it already
# reached — normally skipped, since repeating it is how the same
# introduction reaches one real prospect three times. Exists only to
# exercise that path again on a test account that has already been through
# it once. Leave false everywhere but that.
IG_COMMENT_FORCE_DM=false

# Facebook bridge (apps/fb-bridge) — Messenger DMs and Page comments read off
# the real facebook.com UI, inbound only, no Graph API anywhere in the path.
# There is deliberately no Facebook username or password here and there never
# will be: the operator logs in by hand in a browser window the bridge opens,
# and the session lives only as a Chromium profile on that service's own disk
# (apps/fb-bridge/.fb_bridge_auth/ — gitignored, and as sensitive as a password).
FB_BRIDGE_URL=http://127.0.0.1:8092
FB_BRIDGE_SECRET=dev-fb-bridge-secret-change-me
# Headless by default — true unless set to exactly 'false'. The login window
# never honours this: a human has to see it regardless.
FB_BRIDGE_HEADLESS=true
# Step-by-step timing for the browser flows, on stdout. Off by default; turn it
# on when a Facebook action hangs and you need to know which step owns the wait.
FB_BRIDGE_DEBUG=false
# Where the comment sweep writes the HTML it actually read (the Page timeline
# and each post), to tell "nothing there" from "selectors went stale". Unset is
# off. These pages hold customers' comments: use a private directory, clear it.
# FB_BRIDGE_SNAPSHOT_DIR=

# Automatic private message after a public reply to a comment. OFF by default,
# and the default is the safe one: an unsolicited DM to somebody who just
# commented, sent from browser automation, is what Meta's anti-abuse systems
# look for. With this off the comment still gets its public reply and an agent
# can send the message by hand from the console.
FB_COMMENT_AUTO_DM=false
# Pacing for automated comment actions.
FB_COMMENT_COOLDOWN_MS=60000
FB_COMMENT_BATCH=5
FB_COMMENT_MAX_ATTEMPTS=3
# What the automated flow says. The public reply goes under the Page's name on
# the customer's post; the private message follows only when Facebook offers a
# private reply for that comment. Both are plain text, no templating.
FB_COMMENT_AUTO_REPLY_TEXT=Check DM ya kak!!!
FB_COMMENT_AUTO_DM_TEXT=Halo kak, ini dari Red Panda Test — boleh kami bantu lewat DM ya.
# How far back a reconnecting bridge reads a thread before giving up on finding
# history it already has. Backfill normally stops earlier, at the first known
# message; this is the backstop for a thread whose anchor scrolled out of view.
FB_BACKFILL_MAX_MESSAGES=50

# Where security alerts go, on top of the log. Slack/PagerDuty/ops webhook.
ALERT_WEBHOOK_URL=

# SMTP, e.g. smtps://user:pass@email-smtp.ap-southeast-1.amazonaws.com:465
# Empty means email is logged instead of delivered — and says so loudly at boot.
# Guards /metrics. Set this in production — without it the endpoint is open,
# and traffic volumes are commercially interesting to a competitor.
METRICS_TOKEN=

SMTP_URL=
EMAIL_FROM=MCNASIA <halo@kirana.id>

# Autopilot. Without a key the worker runs a deterministic offline stand-in:
# the guardrails, metering and handover paths behave identically, only the
# generation is fake — so a workspace with no key still works, just dumbly.
ANTHROPIC_API_KEY=
AUTOPILOT_MODEL=claude-opus-5
AUTOPILOT_EFFORT=medium

# DM chatbot — apps/bd-brain, the Python bot pulled in from whatsapp-bot-bd
# (trained-cb), over HTTP (/v1/step, /v1/book, /v1/propose-slots). It answers
# direct messages on WhatsApp Web, the Instagram bridge and the Messenger
# bridge; Autopilot never does. Served by `npm run dev:bd-brain` (python -m
# bd_bot brain-serve, :4321) or the `bd-brain` service in docker-compose.yml.
# Read by the worker straight from process.env (bdBrainFromEnv in
# apps/worker/src/bdBrain.ts), not through env(). These only say where the
# brain is: whether it answers a conversation is set in the console,
# Pengaturan → Chatbot, per division and per connected account.
#
# Unset BD_BRAIN_URL means the bot answers nothing: each run is recorded as
# skipped (`brain_not_configured`), never retried, and the settings page warns.
# The Instagram comment worker also reads its reply wording from this service.
BD_BRAIN_URL=http://127.0.0.1:4321
# The secret must be the same value on both sides — the brain refuses to
# start without one, and a mismatch is a 401 that is not retried: the
# conversation goes straight to "Perlu bantuan". Generate a real one for
# anything but a laptop: openssl rand -hex 32
BD_BRAIN_SECRET=dev-bd-brain-secret-change-me
# Ceiling for one /v1/step call, in ms. Unset or unreadable means 10000, and
# anything above 30000 is held at 30000 so a run stays inside its 2-minute
# lease. Booking and slot proposals always get at least 45000.
BD_BRAIN_TIMEOUT_MS=
# The WhatsApp number an Instagram/Facebook DM lead is handed to once they
# show interest (the BD funnel is comment → DM → WhatsApp → meeting). Written
# exactly as it should read in the message, e.g. "+62 8xx-xxxx-xxxx" — the
# bot does not reformat it. EMPTY ON PURPOSE: BD has not said which of the two
# numbers on the deck takes DM leads. Unset, the DM keeps the lead where it
# is, offers the meeting there, and escalates once so a person sees it. Read
# by the brain (apps/bd-brain), not by the worker.
BD_WHATSAPP_NUMBER=
# Book meetings in an in-memory calendar (every hour free except 13.00)
# instead of Google Calendar. For a laptop with no Google OAuth token in
# apps/bd-brain/secrets/. Never in production.
BD_BRAIN_SIMULATE_CALENDAR=false

# Google Calendar — displays a user's own calendar on Tugas, AND creates/
# updates/cancels the event for a meeting task (Jadwal Meeting) on that same
# calendar. From Google Cloud Console, APIs & Services > Credentials > your
# OAuth client. Redirect URI registered there must exactly match
# http://localhost:3000/api/google-calendar/callback. Requests the
# `calendar.events` scope (read+write on events) — a connection made before
# that scope was added only has `calendar.readonly` and must be reconnected
# once before meeting creation will reach Google Calendar.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

PUBLIC_BASE_URL=http://localhost:8080
CORS_ORIGINS=http://localhost:3000
RATE_LIMIT_PER_MINUTE=600
