# Settings for the bot itself, read by `config.load()` from THIS directory
# (`npm run dev:bd-brain` runs with cwd = apps/bd-brain). Copy to .env and
# edit. Every value here is a default the code already has, so an empty .env
# works — this file exists to show what can be changed.
#
# NOT here, on purpose — these come from the repository root .env, which
# `tsx --env-file=.env` passes through to the Python process:
#   BD_BRAIN_SECRET             shared with the worker; the brain refuses to start without it
#   BD_BRAIN_URL                the worker's side; the port is taken from it (default 4321)
#   BD_WHATSAPP_NUMBER          the DM → WhatsApp hand-off number (empty = hand-off off)
#   BD_BRAIN_SIMULATE_CALENDAR  in-memory calendar for laptops without Google OAuth
#   ANTHROPIC_API_KEY           only used when the two USE_LLM_* flags below are true
# Root .env wins: os.environ.setdefault() never overrides what is already set.

# --- identity: who the templates say is writing ------------------------------
SENDER_NAME=Grace
COMPANY_NAME=MCNAsia.biz
TZ_NAME=Asia/Jakarta

# --- meetings ----------------------------------------------------------------
# Whole hours from START up to (not including) END, one brand per slot, on
# MEETING_WEEKDAYS (0=Senin … 6=Minggu). The hours are quoted verbatim in the
# message bank, so moving them means editing what brands are told.
MEETING_HOUR_START=9
MEETING_HOUR_END=19
MEETING_WEEKDAYS=0,1,2,3,4,5

# --- Google Calendar ---------------------------------------------------------
# OAuth *Desktop app* client JSON from Google Cloud Console, and the token
# `python -m bd_bot gcal-auth` writes after a one-time browser consent.
# `python -m bd_bot gcal-check` says whether bookings will work. The calendar
# id is the BD calendar's, from its settings page; "primary" is the token
# owner's own.
GOOGLE_CREDENTIALS=secrets/google-credentials.json
GOOGLE_TOKEN=secrets/google-token.json
GOOGLE_CALENDAR_ID=primary
# Also invited to every booking (comma-separated). They appear on the
# invite, so the brand can read them.
MEETING_CC_EMAILS=

# --- flow tuning -------------------------------------------------------------
MAX_GADGET_LOOPS=2
MAX_UNKNOWN_STREAK=2
LOOP_GUARD_MAX_REPLIES=6
LOOP_GUARD_WINDOW_MINUTES=15

# --- optional Claude ---------------------------------------------------------
# Rules-only by default: free, offline, deterministic. USE_LLM_INTENTS adds a
# Claude fallback for messages the rules cannot place and the in-context
# reading (understanding.py); USE_LLM_REPLIES generates replies grounded in
# knowledge.py instead of sending the static templates. Both need
# ANTHROPIC_API_KEY (root .env) and both are billed per call.
USE_LLM_INTENTS=false
USE_LLM_REPLIES=false
REPLY_CACHE_VARIANTS=3

# --- grounding corpora (real conversations; NOT in the repo) ----------------
# Point these at a local copy to ground generated replies on the team's own
# chats. A missing directory is not an error — the bot grounds on what it has.
CHAT_EXAMPLES_DIR=chat-example
INBOUND_EXAMPLES_DIR=inbound/sosmed-ke-wa

# --- attachments the flow names (files NOT in the repo) ----------------------
# The flow only flags which document goes with a message; the CRM decides
# whether it has the file. Kept so `simulate` and the tests see the same
# defaults as whatsapp-bot-bd.
OPENING_DIR=opening
COMPANY_PROFILE_PDF=assets/company-profile.pdf
ADS_DECK_PDF=opening/MCNAsia Service Deck - Affiliate, Ads, Full Service & Konten 2026.pdf

# --- the bank account number the bot never says -----------------------------
# knowledge.PAYMENT_ACCOUNT_NUMBER. Not in the source of this copy; empty
# changes nothing the bot says (REPLY_TANYA_REKENING withholds it by design).
PAYMENT_ACCOUNT_NUMBER=
