# Copy to .env and fill in. Nothing here has a safe default in production —
# the API refuses to boot if a development placeholder survives (see env.ts).

NODE_ENV=development
LOG_LEVEL=info
PORT=8080

# The API and worker connect as kirana_app, which is subject to row-level
# security and owns nothing. Migrations run as a separate owner role.
DATABASE_URL=postgres://kirana_app:kirana-app-local@localhost:5432/kirana
DATABASE_MAX_CONNECTIONS=20
# 'transaction' when behind PgBouncer/RDS Proxy/Supavisor — it disables named
# prepared statements, which do not survive a pooler swapping the connection.
DATABASE_POOL_MODE=session
REDIS_URL=redis://localhost:6379

# Key-encrypting key: 32 bytes, base64. Wraps every tenant's data keys.
# Generate with: openssl rand -base64 32
# In production this lives in KMS/Secret Manager and is never written to disk.
KIRANA_KEK=BwcHBwcHBwcHBwcHBwcHBwcHBwcHBwcHBwcHBwc=

# Session signing. Rotate by running two secrets during the overlap window.
JWT_SECRET=dev-only-jwt-secret-change-me-000000
ACCESS_TOKEN_TTL_S=900
REFRESH_TOKEN_TTL_S=2592000

# Meta / WhatsApp Business Platform
META_APP_SECRET=dev-meta-app-secret
META_VERIFY_TOKEN=dev-verify-token
META_GRAPH_URL=https://graph.facebook.com/v21.0
# Comma-separated CIDRs Meta's webhooks may come from. Empty = unconfigured,
# which allows any source. The signature is required either way.
META_IP_ALLOWLIST=

# Where security alerts go, on top of the log. Slack/PagerDuty/ops webhook.
ALERT_WEBHOOK_URL=

# SMTP, e.g. smtps://user:pass@email-smtp.ap-southeast-1.amazonaws.com:465
# Empty means email is logged instead of delivered — and says so loudly at boot.
# Guards /metrics. Set this in production — without it the endpoint is open,
# and traffic volumes are commercially interesting to a competitor.
METRICS_TOKEN=

SMTP_URL=
EMAIL_FROM=Kirana <halo@kirana.id>

# Autopilot. Without a key the worker runs a deterministic offline stand-in:
# the guardrails, metering and handover paths behave identically, only the
# generation is fake — so a workspace with no key still works, just dumbly.
ANTHROPIC_API_KEY=
AUTOPILOT_MODEL=claude-opus-5
AUTOPILOT_EFFORT=medium

PUBLIC_BASE_URL=http://localhost:8080
CORS_ORIGINS=http://localhost:3000
RATE_LIMIT_PER_MINUTE=600
